# ── AI engine (required) ─────────────────────────────────────────────
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model overrides (defaults shown)
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_PRO_MODEL=gemini-pro-latest
# GEMINI_AGENT_MODEL=gemini-flash-latest

# ── Database: Supabase Postgres (required) ──────────────────────────
# Supabase dashboard → your project → Connect → "Transaction pooler" connection string
# (port 6543, best for serverless). Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Optional: DATABASE_SSL=verify to verify Supabase's certificate (set NODE_EXTRA_CA_CERTS to its CA)
# Optional: DATABASE_POOL_MAX=5

# Supabase project details (not required by the server; for future client-side use)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Email sending (optional; otherwise sandbox mode) ─────────────────
# Can also be set per workspace in Settings → Email & sending.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Your Name <you@company.com>"

# ── Sequence scheduler ───────────────────────────────────────────────
# Call POST /api/cron/process every 5–10 minutes with this bearer token.
CRON_SECRET=change-me
