# ── AI engine (required) ─────────────────────────────────────────────
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model overrides (defaults shown)
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_PRO_MODEL=gemini-pro-latest
# GEMINI_AGENT_MODEL=gemini-flash-latest

# ── Database ─────────────────────────────────────────────────────────
# Local SQLite file by default. For serverless hosting (Vercel etc.) use Turso:
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=
DATABASE_URL=file:./data/comuno.db

# ── Email sending (optional; otherwise sandbox mode) ─────────────────
# Can also be set per workspace in Settings → Email & sending.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Your Name <you@company.com>"

# ── Sequence scheduler ───────────────────────────────────────────────
# Call POST /api/cron/process every 5–10 minutes with this bearer token.
CRON_SECRET=change-me
